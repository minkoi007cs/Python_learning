# ==============================================================================
# PyPath Environment Configuration Template
# Copy this file to .env and fill in your local or deployment secrets.
# NEVER commit the real .env file into source control.
# ==============================================================================

# Application Environment
# Options: development | staging | production | test
ENVIRONMENT=development
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# Backend API Configuration (FastAPI)
# ------------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# PostgreSQL Database (AsyncPG driver required)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/pypath_dev

# Supabase Auth & JWT Verification
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-placeholder

# ------------------------------------------------------------------------------
# Frontend Application Configuration (Next.js)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder

# In-Browser Execution Safeguards
NEXT_PUBLIC_PYODIDE_EXECUTION_TIMEOUT_MS=5000
NEXT_PUBLIC_MAX_STDOUT_CHARS=50000

# ------------------------------------------------------------------------------
# Optional AI Tutor Integration (Phase 10)
# ------------------------------------------------------------------------------
AI_TUTOR_PROVIDER=disabled
AI_TUTOR_API_KEY=your-ai-api-key-placeholder
